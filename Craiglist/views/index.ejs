<!doctype html>
<html>
    <head>
        <title>
            Craiglist Demo
        </title>
    </head>
    <body>
        <h1>Categories</h1>
        <ul>
        <% for (const e of categories) { %>
            <li>
                <%= e.name %>
            </li>
            <ul>
                <% for (const p of postings) { %>
                    <% if (p.category_id == e.id) { %>
                        <a href="posting/<%= e.id %>">
                            <li><%= p.title %></li>
                        </a>
                    <% } %>
                <% } %>
            </ul>
        <% } %>
        </ul>

        postings:
        <% postings %>


        <hr>
        <h2>Make a post</h2>
        <form method="post" action="/posts" style="display: flex; flex-direction: column; gap: 10px;">
            <label for="category">Category</label>
            <select>
                <% for (const e of categories) { %>
                    <option value="<%= e.id %>"><%= e.name %></option>
                <% } %>
            </select>

            <label for="name"title>Title</label>
            <input placeholder="jeep cherokee 2014" name="title" required autofocus>

            <label for="body">
                Description
            </label>
            <textarea name="body" placeholder="120k miles" required></textarea>

            <button>Add</button>
        </form>
    </body>
</html>
