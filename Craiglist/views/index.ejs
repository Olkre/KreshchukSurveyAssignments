<!doctype html>
<html>
    <head>
        <title>
            Craiglist Demo
        </title>
    </head>
    <body>
        <h1>Categories</h1>
        <ul>
        <% for (const e of categories) { %>
            <a href="posts/<%= e.id %>">
                <li>
                    <%= e.name %>
                </li>
            </a>
            <ul>
                <% for (const p of postings) { %>
                    <% if (p.category_id == e.id) { %>
                        <a href="post/<%= e.id %>">
                            <li><%= p.title %></li>
                        </a>
                    <% } %>
                <% } %>
            </ul>
        <% } %>
        </ul>

        <a href="/create">Add new post</a>
    </body>
</html>
