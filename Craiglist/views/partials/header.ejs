<!doctype html>
<html>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <title>
        Craiglist Demo
    </title>

    <style type="text/tailwindcss">
        @layer base {
            h1 { @apply text-2xl font-medium tracking-tight }
            h2 { @apply text-xl font-medium  }
            h3 { @apply text-xl font-bold }
            h4 { @apply text-xl font-bold my-[1.33em]; }
            h5 { @apply text-lg font-bold  }
            h6 { @apply text-base font-bold  }

            a:hover { @apply text-blue-800 underline }

            ul { @apply list-disc list-outside pl-10 my-[1em]; }
            ol { @apply list-decimal list-outside pl-10 my-[1em]; }

            input, textarea, select { @apply bg-white rounded-lg px-2 py-1; }

            label { @apply text-sm text-stone-600; }
        }

        .btn {
            @apply bg-blue-100  text-blue-700 px-4 py-2 rounded-2xl hover:bg-blue-200;
        }
    </style>

  </head>
  <body class="p-10 ">
    <header class="flex gap-3 ">
        <a href="/" class="-skew-6 hover:skew-0 transition-all">
            <span class="uppercase tracking-tight bg-black text-white ">Fakelist</span>
        </a>
        <a href="/">Home</a>
        <a href="create">New posting</a>
    </header>

    <hr class="my-5">

    <main class="min-h-[86vh]">
